# Server Configuration
PORT=5000
NODE_ENV=development

# Database Connection (MongoDB URI)
# If left blank, an automatic in-memory MongoDB instance will be used for testing
MONGO_URI=mongodb://127.0.0.1:27017/emailpro

# Google Gemini API Key
# Get a key from https://aistudio.google.com/
GEMINI_API_KEY=

# Default SMTP Settings (Optional - can also be configured from the UI Settings page)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SENDER_NAME=EmailPro Campaign Manager
SENDER_EMAIL=
